@echo off
chcp 65001 >nul
title Codex 一键安装 + 国内模型配置（魔搭GLM-4.6）
cls

:: ==============================================
:: 【在这里填入你的魔搭 ModelScope API Key】
set "API_KEY=ms-ebeacfcc-ca14-4d45-9aed-d70761aa60f0"
:: ==============================================

echo.
echo ==============================================
echo          Codex 全自动安装 + 国内模型配置
echo              无需操作，等待完成
echo ==============================================
echo.

:: ====================== 1. 清理残留 ======================
echo [1/6] 正在清理旧版本残留...
taskkill /f /im codex.exe >nul 2>&1
winget uninstall OpenAI.Codex --silent >nul 2>&1
rd /s /q "%USERPROFILE%\.codex" >nul 2>&1
rd /s /q "%LOCALAPPDATA%\Programs\codex" >nul 2>&1
rd /s /q "C:\Program Files\codex" >nul 2>&1
echo ✅ 清理完成

:: ====================== 2. 用 winget 稳定安装（绕开GitHub） ======================
echo [2/6] 正在用 winget 安装 Codex...
winget install OpenAI.Codex --accept-package-agreements --accept-source-agreements --silent
if %errorlevel% neq 0 (
    echo ❌ winget 安装失败，请手动安装 Codex 后重试
    pause
    exit /b 1
)
echo ✅ 安装完成

:: ====================== 3. 刷新环境变量（立即生效） ======================
echo [3/6] 正在刷新环境变量...
set "PATH=%PATH%;%LOCALAPPDATA%\Programs\codex"
echo ✅ 环境变量刷新完成

:: ====================== 4. 配置国内模型 ======================
echo [4/6] 正在配置魔搭 GLM-4.6...
md "%USERPROFILE%\.codex" >nul 2>&1

(
echo model = "ZhipuAI/GLM-4.6"
echo model_provider = "modelscope"
echo.
echo [model_providers.modelscope]
echo name = "Modelscope"
echo base_url = "https://api-inference.modelscope.cn/v1"
echo env_key = "MODELSCOPE_API_KEY"
) > "%USERPROFILE%\.codex\config.toml"

:: 设置API Key环境变量（永久）
setx MODELSCOPE_API_KEY "%API_KEY%" >nul 2>&1
set "MODELSCOPE_API_KEY=%API_KEY%"
echo ✅ 模型配置完成

:: ====================== 5. 验证安装并启动 ======================
echo [5/6] 正在验证 Codex 命令...
codex --version >nul 2>&1
if %errorlevel% neq 0 (
    echo ⚠️ 首次验证失败，正在重试...
    set "PATH=%PATH%;%LOCALAPPDATA%\Programs\codex"
    codex --version >nul 2>&1
)

echo [6/6] 正在启动 Codex...
echo.
codex

echo.
echo ✅ Codex 启动成功！
pause